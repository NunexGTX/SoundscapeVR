@startuml
class ReapyControllerCommunication {
    + EnableCommunication : bool = true
    + autoconnect : bool = true
    + startReaperCommunication() : void
    + {static} readIPFile() : string
    + setServerIP(ip:string) : void
    + setAndConnectIP(ip:string) : void
    + getServerIP() : string
    + getPort() : int
    + connection_status() : string
    + ClockSync() : void
    + ClockSyncResult(t_rx:long) : void
    + NewSoundscape(duration:int, loop:bool) : void
    + <<async>> StartSoundscapeLockAndLoad() : Task
    + StartSoundscape() : void
    + SkipStartSoundscape() : void
    + StopSoundscape() : void
    + NewTrack(audioID:string, soundUUID:Guid, volume:float, loop:bool, delay:uint) : void
    + UpdateSourcePosition(soundUUID:Guid, azim:float, elev:float, Distance:float) : void
    + MuteTrack(soundUUID:Guid) : void
    + UnmuteTrack(soundUUID:Guid) : void
    + DeleteTrack(soundUUID:Guid) : void
    + Reset() : void
    + AddEffectToAudio(soundUUID:Guid, audioEffectInstance:AudioEffectInstance) : void
}
MonoBehaviour <|-- ReapyControllerCommunication
ReapyControllerCommunication o-> "connectionTimeOutMillis" Int32
ReapyControllerCommunication --> "vrStateData" VrStateData
ReapyControllerCommunication o-> "loadingManager" LoadingManager
@enduml
