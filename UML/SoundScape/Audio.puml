@startuml
class Audio {
    + id : string
    + name : string
    + fileName : string
    + imagePath : string
    + fileType : string
    + type : string
    + ambisonicAssetName : string = ""
    + SetTexture(texture:Texture2D) : void
    + UnloadBundle() : void
    + HasImage() : bool
    + GetRealAudioPath() : string
    + IsAmbisonic() : bool
    + <<const>> TYPE_STANDARD : string = "standard"
    + <<const>> TYPE_AMBISONIC : string = "ambisonic"
}
Audio o-> "bundle" AssetBundle
Audio --> "texture2D" Texture2D
@enduml
