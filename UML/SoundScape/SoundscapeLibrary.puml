@startuml
class SoundscapeLibrary {
    + ReplaceOrAddSoundscape(updatedSoundscape:Soundscape) : void
    + UpdateSoundscapeData(soundscapeId:string, updatedSoundscape:Soundscape) : void
    + CreateSourceAt(audio:Audio, spherePosition:Vector3) : AudioSource
    + CreateSourceAt(audioId:string, spherePosition:Vector3) : AudioSource
    + DoesSoundscapeExist(soundscapeTitle:string) : bool
    + DeleteSoundscape(soundscapeTitle:string) : bool
    + {static} GetStreamingPath(fileName:string) : string
    + {static} GetSoundscapeFilePath() : string
    + {static} GetAudioFilePath() : string
    + {static} GetReaperControllerIPFilePath() : string
    + {static} GetFormFilePath() : string
    + <<async>> GetClipForAudio(audioId:string) : Task<IAudioGenerator>
    + <<async>> LoadAudioClipsAsync(audioIds:List<string>) : Task
    + <<async>> LoadAudioClipsAsync(audios:List<Audio>) : Task
    + ClearAudioCache(soundscapeId:string) : void
    + {static} WorldToSphere(worldCoords:Vector3) : Vector3
    + {static} SphereToWorld(sphereCoords:Vector3) : Vector3
    + {static} DistanceInSphere(sphere1:Vector3, sphere2:Vector3) : float
    + GetAudioType(audioId:string) : string
    + IsAudioLoaded(audioId:string) : bool
    + GetIconForAudio(audioId:string) : Texture2D
}
MonoBehaviour <|-- SoundscapeLibrary
SoundscapeLibrary o-> "audioList" AudioList
SoundscapeLibrary o-> "soundscapeList" SoundscapeList
SoundscapeLibrary o-> "form" Form
SoundscapeLibrary --> "loadingManager" LoadingManager
SoundscapeLibrary --> "defaultAudioIcon" Texture2D
@enduml
