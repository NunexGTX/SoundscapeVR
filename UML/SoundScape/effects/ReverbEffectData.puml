@startuml
class ReverbEffectData {
    + getPresetNames() : List<string>
    + ReverbEffectData(reverbEffectData:ReverbPresets)
    + <<override>> CopyValues(other:AudioEffectData) : AudioEffectData
    + <<override>> ApplyEffectToSource(audioClipObject:GameObject) : void
    + <<override>> IsEffectAppliedInUI(root:VisualElement) : bool
    + <<override>> CollectFromUI(root:VisualElement) : AudioEffectData
    + <<override>> ApplyDefaultUI(root:VisualElement) : void
    + <<override>> ApplyValuesToUI(root:VisualElement) : void
    + <<override>> GetTrackParams() : string[]
}
enum ReverbPresets {
    Auditorium,
    Parliment,
}
AudioEffectData <|-- ReverbEffectData
ReverbEffectData o-> "currentPreset" ReverbPresets
ReverbEffectData +-- ReverbPresets
@enduml
