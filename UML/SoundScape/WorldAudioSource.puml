@startuml
class WorldAudioSource {
    + debug : bool = true
    + GetUUID() : Guid
    + SetUUID(uuid:Guid) : void
    + DestroySource() : void
    + <<async>> PlayAudio(incLoading:bool) : Task
    + SetIconEnabledState(isMuted:bool) : void
    + FlipMuteState() : void
    + IsVisible() : bool
    + PasteDataFrom(copiedAudioSource:AudioSource) : void
    + ResetMaterial(defaultMaterial:Material) : void
}
MonoBehaviour <|-- WorldAudioSource
WorldAudioSource --> "audioSource" AudioSource
WorldAudioSource --> "soundscapeWrapper" SoundscapeWrapper
WorldAudioSource --> "canvas" GameObject
WorldAudioSource --> "library" SoundscapeLibrary
WorldAudioSource --> "vrStateData" VrStateData
WorldAudioSource --> "playbackType" AudioListeningType
WorldAudioSource --> "reaperController" ReapyControllerCommunication
WorldAudioSource --> "loadingManager" LoadingManager
@enduml
