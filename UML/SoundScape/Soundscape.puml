@startuml
abstract class Soundscape {
    + title : string
    + timeSeconds : int = 90
    + staticPath : string = null
    + encompassingPath : string = null
    + projectionType : string = "None"
    + loop : bool = true
    + {static} <<readonly>> VIDEO_GO_NAME : string = "soundscapeVideo"
    + {static} CreateSoundscape(title:string, time:int, staticPath:string, encompassingPath:string, projectionType:string, loop:bool, video:bool) : Soundscape
    + OnVisualsLoaded(action:Action) : void
    + OnVisualsFail(action:Action) : void
    + <<virtual>> ClearVisualsBinding() : void
    + GetTitle() : string
    + GetAudioSources() : List<AudioSource>
    + AddSource(audio:AudioSource) : void
    + CopySourcesFrom(other:Soundscape) : void
    + SetEdit(debug:bool) : void
    + DeleteScreen() : void
    + {static} SetProjectionType(projectionType:string, mat:Material) : void
    + SetScreenAtHeight(yLevel:float) : void
    + GetScreenObject() : GameObject
    + RemoveSource(audio:AudioSource) : void
    + {abstract} Copy() : Soundscape
    + {abstract} TryGetVisuals(visualType:VisualType, videoPlaying:Boolean) : GameObject
    + {abstract} GetSupportedVisual() : VisualType
    + {abstract} RestartVisuals(ssVisual:GameObject, visualType:VisualType, delay:float) : void
}
@enduml
