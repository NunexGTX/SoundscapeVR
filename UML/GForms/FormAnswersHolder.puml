@startuml
class FormAnswersHolder {
    + pageCount : int = 1
    + AreRequiredComplete() : bool
    + AreRequiredComplete(idxLimit:int) : bool
    + IsQuestionAnswered(qId:string) : bool
    + GetSingleAnswer(qId:string) : string
    + GetRepeatableAnswers(qId:string) : List<string>
    + RegisterRequiredQuestion(sectionIdx:int, qId:string) : void
    + AddSingleAnswer(qId:string, value:string) : void
    + ToggleRepeatableAnswer(qId:string, value:string, toggleOn:bool) : void
    + RemoveSingleAnswer(qId:string) : void
    + GetAnswerList() : List<KeyValuePair<string, string>>
    + Clear() : void
}
@enduml
