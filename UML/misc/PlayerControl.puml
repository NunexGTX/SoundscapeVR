@startuml
class PlayerControl {
    + walkSpeed : float = 5f
    + gravity : float
    + jumpHeight : float = 1.5f
    + mouseSensitivity : float = 2f
    + upperLookLimit : float = 80f
    + lowerLookLimit : float
    + IsDisabled() : bool
    + SetPlayerRotation(canRotate:bool) : void
    + SetPlayerMovement(canMove:bool) : void
    + OnMove(value:InputValue) : void
    + OnLook(value:InputValue) : void
    + OnJump(value:InputValue) : void
}
MonoBehaviour <|-- PlayerControl
PlayerControl --> "cameraTransform" Transform
@enduml
