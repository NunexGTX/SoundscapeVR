<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoundscapeFiles/UI/styles/testStyle.uss?fileID=7433441132597879392&amp;guid=af1d223cdcfbc514fbde70ae6e4a7fb4&amp;type=3#testStyle"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" mouse-wheel-scroll-size="18" style="height: 100%;">
            <ui:Button text="Go Back" name="returnBtn" class="buttonStyle"/>
            <ui:Label text="" name="selectedSoundscape"/>
            <ui:Foldout text="Make Soundscape" value="false" name="settingsFoldout" style="margin-left: 6px;">
                <ui:TextField label="Title*" placeholder-text="Soundscape Name" name="titleInput" style="flex-direction: column;"/>
                <ui:IntegerField label="Time in Seconds" value="90" name="timeInput"/>
                <ui:Toggle label="Loop" name="loopToggle"/>
                <ui:Toggle label="Video Soundscape" name="videoToggle" style="align-content: flex-start; justify-content: flex-start; align-self: auto; align-items: stretch; flex-wrap: wrap; flex-direction: row;"/>
                <ui:TextField label="2D Video Location" placeholder-text="coolVideos/Rick.mp4" name="2dPath" style="flex-direction: column;"/>
                <ui:TextField label="360 Video Location" placeholder-text="Cool Videos/Wide Rick.mp4" name="360Path" style="flex-direction: column;"/>
                <ui:DropdownField label="Projection Type" choices="None (As Is),Side by Side,Over Under" index="0" name="projectionDropdown" style="flex-direction: column;"/>
                <ui:Label text="" name="debugLabel" style="white-space: normal;"/>
                <ui:Button text="Create" name="createBtn" style="background-color: rgb(168, 255, 155); margin-top: 11px; height: 42px; width: 100%; align-self: center; margin-right: 4%;"/>
            </ui:Foldout>
            <ui:VisualElement name="soundscapes" style="flex-grow: 1; height: auto; max-height: 50%;">
                <ui:Label text="Soundscapes"/>
                <ui:ListView name="soundscapeList" virtualization-method="DynamicHeight" show-border="false"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
