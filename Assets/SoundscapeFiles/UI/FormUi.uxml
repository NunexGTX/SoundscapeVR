<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoundscapeFiles/UI/styles/testStyle.uss?fileID=7433441132597879392&amp;guid=af1d223cdcfbc514fbde70ae6e4a7fb4&amp;type=3#testStyle"/>
    <ui:VisualElement style="flex-grow: 1; margin-top: 5px; margin-bottom: 9px; justify-content: flex-start; align-items: flex-start; align-self: auto; align-content: center; flex-direction: column; flex-wrap: nowrap;">
        <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-items: center; justify-content: flex-start; align-self: auto; align-content: auto; flex-direction: column; flex-wrap: nowrap; height: -55px; max-height: 25%; margin-bottom: 4px;">
            <ui:Button text="Back to main menu" parse-escape-sequences="false" name="returnBtn" class="buttonStyle" style="margin-bottom: 1px;"/>
            <ui:Label text="Form Title" name="formTitle" style="-unity-text-align: upper-center; white-space: normal; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            <ui:Image source="project://database/Assets/Resources/bar.png?fileID=2800000&amp;guid=13922342b32ba0946a94978980a32d5f&amp;type=3#bar" scale-mode="StretchToFill" style="justify-content: flex-start; align-self: stretch; align-content: flex-start; width: auto;"/>
        </ui:VisualElement>
        <ui:ScrollView scroll-deceleration-rate="-0.03" name="ScrollView" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden" style="align-items: auto; justify-content: center; align-self: auto; min-width: 0; flex-direction: column; top: auto; max-height: 75%; min-height: initial;">
            <ui:VisualElement name="formRoot" style="flex-grow: 1; flex-wrap: wrap;">
                <ui:Button text="Start" name="nextBtn" double-click-selects-word="false" triple-click-selects-line="false"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
