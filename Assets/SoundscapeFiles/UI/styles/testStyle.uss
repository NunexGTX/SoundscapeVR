:root {
    opacity: 1;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    -unity-text-align: upper-left;
    font-size: 18px;
    background-color: rgb(177, 205, 209);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    text-overflow: clip;
}

.buttonStyle {
    opacity: 1;
    background-color: rgb(227, 229, 255);
    background-size: 56% 100%;
    -unity-background-scale-mode: scale-to-fit;
    width: 85%;
    left: auto;
    align-self: center;
    padding-top: 9px;
    margin-top: 14px;
    margin-bottom: 9px;
    align-items: auto;
    justify-content: flex-start;
    align-content: auto;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    height: 42px;
}

.radioStyle {
    padding-top: 19px;
    margin-top: 9px;
    margin-right: 9px;
    margin-bottom: 9px;
    margin-left: 9px;
    padding-right: 13px;
    padding-bottom: 13px;
    padding-left: 13px;
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-right-radius: 22px;
    border-bottom-left-radius: 22px;
    background-color: rgb(227, 229, 254);
    width: 90%;
    height: auto;
    -unity-text-align: upper-left;
    align-self: center;
    flex-direction: row;
    -unity-font-style: normal;
    letter-spacing: 0;
    text-overflow: ellipsis;
    white-space: normal;
}

.headerStyle {
    font-size: 20px;
    -unity-font-style: bold;
    padding-left: 2px;
    align-self: flex-start;
    left: 5%;
}

.backgroundStyle {
    flex-grow: 1;
}

.unity-button:hover {
    background-color: rgb(0, 255, 0);
    scale: 1.1;
}

.unity-button {
}

.disable_buttons {
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 7px;
    background-color: rgb(227, 229, 255);
    padding-top: 9px;
    margin-top: 14px;
    margin-bottom: 9px;
    width: auto;
    flex-direction: row;
}

.btn {
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-scroller__slider {
    margin: 0;
}

.unity-scroller__slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.unity-scroller__slider .unity-base-slider__dragger {
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 0;
    border-radius: 3px;
    width: 5px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.unity-scroller__slider .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.6);
}

.unity-scroller__slider .unity-base-slider__dragger:active {
    background-color: rgba(255, 255, 255, 0.9);
}

.unity-scroller--vertical {
    width: 5px;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 3px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-delay: 0.8s;
}

.unity-scroll-view:hover .unity-scroller--vertical {
    opacity: 1;
    transition-delay: 0s;
    transition-duration: 0.15s;
}

.unity-scroller--horizontal {
    height: 5px;
    background-color: rgba(0, 0, 0, 0);
}

#lowPassFreq.unity-base-slider--horizontal .unity-base-slider__text-field {
    width: 35%;
}

#highPassFreq.unity-base-slider--horizontal .unity-base-slider__text-field {
    width: 32%;
}

#saveBtn Image {
    width: 11%;
    padding: 0;
    padding-left: 3%;
}

#saveBtn TextElement {
    width: 100%;
    margin-left: -5%;
}

#soundscapeList {
    flex-shrink: 0;
    height: auto;
    min-height: 0;
}

#soundscapeList .unity-scroll-view__viewport {
    overflow: visible;
}

#soundscapeList #unity-content-and-vertical-scroll-container {
    flex-grow: 1;
    flex-shrink: 0;
}

VisualElement > .unity-scroll-view--vertical > #settingsFoldout > #unity-content {
    margin-left: 4%;
}

VisualElement > .unity-scroll-view--vertical > #settingsFoldout > #projectionDropdown > .unity-popup-field__input {
    margin-left: 0;
}

.unity-radio-button__text {
    margin-bottom: 17px;
    padding-bottom: 0;
    margin-top: 13px;
    padding-top: 0;
    padding-right: 0;
    padding-left: 0;
}
