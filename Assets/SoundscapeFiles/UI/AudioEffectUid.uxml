<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/SoundscapeFiles/UI/styles/testStyle.uss?fileID=7433441132597879392&amp;guid=af1d223cdcfbc514fbde70ae6e4a7fb4&amp;type=3#testStyle"/>
    <Style src="project://database/Assets/SoundscapeFiles/UI/styles/sliderStyle.uss?fileID=7433441132597879392&amp;guid=12ecb2eb793a3264f84d7d10dce03e48&amp;type=3#sliderStyle"/>
    <ui:ScrollView name="ScrollView" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
        <ui:Label text="Audio Name" name="audioName" style="margin-top: 5px; -unity-text-align: upper-center;"/>
        <ui:Slider label="Volume" value="1" high-value="1" show-input-field="true" fill="true" name="volume"/>
        <ui:SliderInt label="Start Delay (s)" value="0" high-value="300" show-input-field="true" fill="true" low-value="0" name="delay"/>
        <ui:Toggle label="Loop Audio" name="loop"/>
        <ui:Foldout text="Echo Effect" name="echoFoldout" value="false" style="background-color: rgba(0, 0, 0, 0.1); margin-top: 5px; padding: 5px;">
            <ui:Toggle label="Apply Echo" name="echoToggle"/>
            <ui:SliderInt label="Delay (ms)" value="500" high-value="5000" show-input-field="true" fill="true" low-value="10" name="echoDelay"/>
            <ui:Slider label="Decay Ratio" value="0.5" high-value="1" show-input-field="true" fill="true" name="echoDecay"/>
            <ui:Slider label="Dry Mix" value="1" high-value="1" show-input-field="true" fill="true" low-value="0" name="echoDry"/>
            <ui:Slider label="Wet Mix" value="1" high-value="1" show-input-field="true" fill="true" name="echoWet"/>
        </ui:Foldout>
        <ui:Foldout text="Occlusion" name="occlusionFoldout" value="true" style="background-color: rgba(0, 0, 0, 0.1); margin-top: 5px; padding: 5px;">
            <ui:Toggle label="Apply Occlusion" name="occlusionToggle"/>
            <ui:Toggle label="Frequency Dependent" name="freqToggle"/>
            <ui:Label text="Frequency dependent will apply separate attenuation for low, mid, and high frequencies, added to the result of general occlusion.&#10;If general occlusion is set to 1, the sound will still be heard clearly." triple-click-selects-line="false" double-click-selects-word="false" display-tooltip-when-elided="false" name="Label" style="flex-wrap: wrap; flex-direction: column; white-space: normal; width: auto; left: -25px;"/>
            <ui:Label text="0 = Full Attenuation&#10;1 = No Attenuation" triple-click-selects-line="false" double-click-selects-word="false" display-tooltip-when-elided="false" style="left: -25px;"/>
            <ui:Slider label="General Occlusion" value="1" high-value="1" show-input-field="true" fill="true" name="occlusionValue" inverted="false"/>
            <ui:Slider label="Low Freq." value="1" high-value="1" show-input-field="true" fill="true" name="lowFreqOcc"/>
            <ui:Slider label="Mid Freq." value="1" high-value="1" show-input-field="true" fill="true" low-value="0" name="midFreqOcc"/>
            <ui:Slider label="High Freq." value="1" high-value="1" show-input-field="true" fill="true" name="highFreqOcc"/>
        </ui:Foldout>
    </ui:ScrollView>
    <ui:Button text="Save Effects" name="saveBtn" class="buttonStyle"/>
</ui:UXML>
