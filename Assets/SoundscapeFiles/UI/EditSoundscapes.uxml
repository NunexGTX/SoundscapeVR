<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoundscapeFiles/UI/styles/testStyle.uss?fileID=7433441132597879392&amp;guid=af1d223cdcfbc514fbde70ae6e4a7fb4&amp;type=3#testStyle"/>
    <ui:VisualElement style="flex-grow: 1;">
        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" mouse-wheel-scroll-size="18" style="height: 100%;">
            <ui:Button text="Go Back" name="returnBtn" class="buttonStyle"/>
            <ui:Button text="Save And Apply Changes" name="saveBtn" icon-image="project://database/Assets/SoundscapeFiles/UI/icons/diskette-save-svgrepo-com.svg?fileID=7388822144124034973&amp;guid=eb282bdf82f03bf32b68265a70695e61&amp;type=3#diskette-save-svgrepo-com" class="buttonStyle" style="align-self: center; justify-content: space-between; align-items: center; flex-direction: row;"/>
            <ui:Label text="" name="selectedSoundscape"/>
            <ui:Foldout text="Soundscape Settings" value="false" name="settingsFoldout">
                <ui:TextField label="Title*" placeholder-text="filler text" name="titleInput" style="flex-direction: column;"/>
                <ui:IntegerField label="Time in Seconds" value="90" name="timeInput"/>
                <ui:Toggle label="Video Soundscape" name="videoToggle" style="align-content: flex-start; justify-content: flex-start; align-self: auto; align-items: stretch; flex-wrap: wrap; flex-direction: row;"/>
                <ui:Toggle label="Loop?" name="loopToggle"/>
                <ui:TextField label="Path to 2D" placeholder-text="filler text" name="2dPath" style="flex-direction: column;"/>
                <ui:TextField label="Path to 360" placeholder-text="filler text" name="360Path" style="flex-direction: column;"/>
                <ui:DropdownField label="Projection Type" choices="None (As Is),Side by Side,Over Under" index="0" name="projectionDropdown" style="flex-direction: column;"/>
                <ui:Label text="" name="debugLabel" style="white-space: normal;"/>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center; align-self: center;"/>
                <ui:VisualElement style="flex-grow: 1;">
                    <ui:Button text="Delete" name="deleteBtn" style="background-color: rgb(255, 134, 134); margin-top: 11px; height: 42px; justify-content: flex-start; align-content: auto;"/>
                </ui:VisualElement>
            </ui:Foldout>
            <ui:Label text="" name="selectedAudio"/>
            <ui:VisualElement name="audios" style="flex-grow: 1; height: auto; opacity: 1; background-color: rgb(117, 152, 154); margin-top: 9px; margin-right: 9px; margin-bottom: 9px; margin-left: 9px; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                <ui:Label text="Audio Library"/>
                <ui:VisualElement name="libraryList" style="flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
