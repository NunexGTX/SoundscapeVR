<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoundscapeFiles/UI/styles/testStyle.uss?fileID=7433441132597879392&amp;guid=af1d223cdcfbc514fbde70ae6e4a7fb4&amp;type=3#testStyle"/>
    <ui:VisualElement enabled="true" name="VisualElement" style="flex-grow: 1; background-color: rgb(36, 35, 35);">
        <ui:Image source="project://database/Assets/SoundscapeFiles/UI/icons/noFolderPermissions.svg?fileID=7388822144124034973&amp;guid=c84f17dd1faf81064b397101bb187860&amp;type=3#noFolderPermissions" scale-mode="ScaleToFit" style="height: 300px;"/>
        <ui:Label text="SoundscapeVR does not have Storage Permissions" style="color: rgb(255, 255, 255); font-size: 132px; -unity-text-align: upper-center; align-items: stretch;"/>
        <ui:Label text="Without them, you won&apos;t be able to bring your own media files" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); font-size: 131px;"/>
        <ui:Label text="Do you wish to give those permissions?" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); font-size: 139px;"/>
        <ui:GroupBox usage-hints="None" focusable="false" style="font-size: 73px; opacity: 1; flex-direction: row; flex-wrap: nowrap; align-items: stretch; justify-content: space-evenly; align-self: auto; align-content: flex-start;">
            <ui:Button text="Skip"/>
            <ui:Button text="Yes" style="width: auto; position: relative; left: auto; flex-direction: column; align-items: stretch; align-self: auto;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
